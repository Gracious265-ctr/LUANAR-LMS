# Django
DEBUG=True
# Generate your own with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-me-generate-a-real-key-in-dotenv
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://luanar:luanar@localhost:5432/luanar_leave

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Supabase Storage
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_BUCKET=leave-documents

# Leave document storage (Unit 19)
# development = local filesystem (no external credentials needed)
# supabase     = Supabase Storage (requires SUPABASE_URL/SUPABASE_SERVICE_KEY)
LEAVE_STORAGE_BACKEND=leave.storage.development.DevelopmentStorageBackend
# LEAVE_STORAGE_ROOT=/absolute/path/to/repo/storage
