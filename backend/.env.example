# Django
DEBUG=True
# Generate your own with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-me-generate-a-real-key-in-dotenv
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://luanar:luanar@localhost:5432/luanar_leave

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Supabase Storage
# SUPABASE_URL must be the BARE project URL — host only, no path.
# The Supabase dashboard's "Project URL" field ends in /rest/v1/; do not copy it
# verbatim. supabase-py appends its own /storage/v1/... paths, so a suffixed URL
# sends every storage request to PostgREST and fails with an opaque 404.
SUPABASE_URL=https://your-project-ref.supabase.co
# The service_role key bypasses row-level security. Keep it in .env only, never
# in this file or anywhere else committed.
SUPABASE_SERVICE_KEY=your-service-role-key
# The bucket must already exist in the project (Dashboard > Storage, or created
# with the storage API).
SUPABASE_BUCKET=leave-documents

# Email
# Leave the default until you want real mail: the console backend prints every
# message to stdout instead of sending it, so a tree with no credentials below
# still runs. Nothing in this file is committed — see .gitignore.
#
# Google SMTP: turn on 2-Step Verification for the account, then create an App
# Password (Google Account > Security > 2-Step Verification > App passwords).
# The App Password is what goes in EMAIL_HOST_PASSWORD, not the account password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-account@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
# Must be an address the account above is authorised to send as. Gmail rejects an
# unknown From: outright, and every notification mail would land in `failed`.
# A Gmail account can send as an alias once it is added under Settings > Accounts.
DEFAULT_FROM_EMAIL=your-account@gmail.com
# Leave True for a single-process development server (mail is delivered inline);
# set False and run `uv run manage.py qcluster` where a worker should own it.
NOTIFICATIONS_SYNC_SEND=True
# Development only, comma-separated. The seeded users carry undeliverable
# @test.luanar addresses, so a live smoke test fails on every recipient unless
# the messages are routed into one inbox. Ignored unless DEBUG=True. Once real
# employees exist, leave this unset — the recipients are then real.
# EMAIL_DEV_RECIPIENT_OVERRIDE=you@gmail.com

# The absolute base URL of the Next.js app. A set-password link is the one email
# a person has to be able to click, so it cannot be built without this. Outside
# DEBUG the value must be https:// — a password link over plain HTTP is refused
# rather than sent.
FRONTEND_URL=http://localhost:3000
# How long a set-password link stays usable. 72h suits an inbox read at a human
# pace; issuing a new link invalidates the previous one either way.
PASSWORD_SET_TOKEN_LIFETIME_HOURS=72
